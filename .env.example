# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/poaley_chedec
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/poaley_chedec_test

# Backend
SECRET_KEY=change-me-to-a-long-random-secret-key
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Jerusalem

# Zmanim (Hebcal location for computed prayer times — אפרים 52, אשקלון)
ZMANIM_LATITUDE=31.669
ZMANIM_LONGITUDE=34.571
ZMANIM_TZID=Asia/Jerusalem

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed (JSON array)
ADMIN_USERS=[{"username":"admin","password":"changeme123"}]

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@poaleitzedek.org
CONTACT_RECIPIENT_EMAIL=taktuk01@gmail.com

# Cloudinary (required for admin image uploads — get from https://console.cloudinary.com)
# CLOUDINARY_CLOUD_NAME is a short name like "my-app", not a UUID
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nedarim Plus — donation receipt webhooks
NEDARIM_MOSAD_ID=7018669
NEDARIM_API_PASSWORD=
NEDARIM_WEBHOOK_SECRET=
NEDARIM_RECONCILE_SECRET=
NEDARIM_HMAC_MAX_SKEW_SECONDS=300

# Yemot HaMashiach SMS (permanent API KEY from חומת האש)
YEMOT_API_KEY=
YEMOT_SMS_FROM=
YEMOT_API_BASE_URL=https://www.call2all.co.il/ym/api

# GreenAPI WhatsApp (secondary channel)
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=https://api.green-api.com

# Frontend (must include /api/v1 — or set host only and the app will append it)
VITE_API_BASE_URL=http://localhost:8000/api/v1
